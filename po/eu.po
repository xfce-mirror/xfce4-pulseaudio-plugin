#: panel-plugin/pulseaudio.desktop.in.in:5
msgid "PulseAudio Plugin"
msgstr "PulseAudio plugina"

#: panel-plugin/pulseaudio.desktop.in.in:6
#: panel-plugin/pulseaudio-plugin.c:274
msgid "Adjust the audio volume of the PulseAudio sound system"
msgstr "Doitu PulseAudio soinu-sistemaren bolumena"

#: panel-plugin/pulseaudio-dialog.glade:51
msgid "None"
msgstr "Bat ere ez"

#: panel-plugin/pulseaudio-dialog.glade:54
msgid "All"
msgstr "Denak"

#: panel-plugin/pulseaudio-dialog.glade:57
msgid "Output only"
msgstr "Irteera soilik"

#: panel-plugin/pulseaudio-dialog.glade:60
msgid "Input only"
msgstr "Sarrera soilik"

#: panel-plugin/pulseaudio-dialog.glade:66
msgid "PulseAudio Panel Plugin"
msgstr "PulseAudio panel-plugina"

#: panel-plugin/pulseaudio-dialog.glade:151
msgid "Enable keyboard _shortcuts for volume control"
msgstr "Gaitu teklatuko _lasterbideak bolumena kontrolatzeko"

#: panel-plugin/pulseaudio-dialog.glade:155
msgid ""
"Enables volume control using multimedia keys. Make sure no other application"
" that listens to these keys (e.g. xfce4-volumed) is running in the "
"background."
msgstr "Bolumena multimedia-teklekin kontrolatzea gaitzen du. Ziurtatu tekla horiei entzuten dien beste aplikaziorik (adib. xfce4-volumed) ez dela atzeko planoan exekutatzen ari."

#: panel-plugin/pulseaudio-dialog.glade:168
msgid "Play system _sound when volume changes"
msgstr "Erreproduzitu sistemaren _soinua bolumena aldatzean"

#: panel-plugin/pulseaudio-dialog.glade:172
msgid ""
"Enables audio feedback when using multimedia keys to change the volume."
msgstr "Soinu bidezko erantzuna gaitzen du multimedia-teklekin bolumena aldatzean."

#: panel-plugin/pulseaudio-dialog.glade:185
msgid "Always display the recording _indicator"
msgstr "Erakutsi beti grabazioaren _adierazlea"

#: panel-plugin/pulseaudio-dialog.glade:208
msgid "Show volume _notifications:"
msgstr "Erakutsi bolumenaren _jakinarazpenak:"

#: panel-plugin/pulseaudio-dialog.glade:222
msgid "Mute/unmute is notified in all modes except \"None\""
msgstr "Isiltzea eta soinua berreskuratzea modu guztietan jakinarazten da, \"Bat ere ez\" moduan izan ezik"

#: panel-plugin/pulseaudio-dialog.glade:248
msgid "Step size used when adjusting volume with mouse wheel or hotkeys."
msgstr "Saguaren gurpilarekin edo laster-teklekin bolumena doitzean erabiltzen den urratsaren tamaina."

#: panel-plugin/pulseaudio-dialog.glade:254
msgid "_Volume step:"
msgstr "_Bolumen-urratsa:"

#: panel-plugin/pulseaudio-dialog.glade:300
msgid "M_aximum volume:"
msgstr "_Gehienezko bolumena:"

#: panel-plugin/pulseaudio-dialog.glade:345
msgid "Behaviour"
msgstr "Portaera"

#: panel-plugin/pulseaudio-dialog.glade:380
msgid "Audio _Mixer"
msgstr "Audio-_nahasgailua"

#: panel-plugin/pulseaudio-dialog.glade:392
msgid ""
"Audio mixer command that can be executed from the context menu, e.g. "
"\"pavucontrol\", \"unity-control-center sound\"."
msgstr "Laster-menutik exekuta daitekeen audio-nahasgailuaren komandoa, adib. \"pavucontrol\", \"unity-control-center sound\"."

#: panel-plugin/pulseaudio-dialog.glade:405
msgid "_Run Audio Mixer..."
msgstr "_Exekutatu audio-nahasgailua..."

#: panel-plugin/pulseaudio-dialog.glade:427
msgid "Sound Settings"
msgstr "Soinuaren ezarpenak"

#: panel-plugin/pulseaudio-dialog.glade:446
msgid "General"
msgstr "Orokorra"

#: panel-plugin/pulseaudio-dialog.glade:478
msgid "Control Playback of Media Players"
msgstr "Kontrolatu multimedia-erreproduzitzaileen erreprodukzioa"

#: panel-plugin/pulseaudio-dialog.glade:521
msgid "Enable multimedia keys for playback control"
msgstr "Gaitu multimedia-teklak erreprodukzioa kontrolatzeko"

#: panel-plugin/pulseaudio-dialog.glade:536
msgid "Send multimedia keys to all players"
msgstr "Bidali multimedia-teklak erreproduzitzaile guztiei"

#: panel-plugin/pulseaudio-dialog.glade:551
msgid "Enable experimental window focus support"
msgstr "Gaitu leiho-fokuaren euskarri esperimentala"

#: panel-plugin/pulseaudio-dialog.glade:629
msgid "Name"
msgstr "Izena"

#: panel-plugin/pulseaudio-dialog.glade:641
msgid "Persistent"
msgstr "Iraunkorra"

#: panel-plugin/pulseaudio-dialog.glade:652
msgid "Ignored"
msgstr "Baztertua"

#: panel-plugin/pulseaudio-dialog.glade:672
msgid "Clear Known Items"
msgstr "Garbitu elementu ezagunak"

#: panel-plugin/pulseaudio-dialog.glade:694
msgid "Please restart the players to make them visible again."
msgstr "Berrabiarazi erreproduzitzaileak berriro ikusgai egon daitezen."

#: panel-plugin/pulseaudio-dialog.glade:717
msgid "Known Media Players"
msgstr "Multimedia-erreproduzitzaile ezagunak"

#: panel-plugin/pulseaudio-dialog.glade:739
msgid "Media Players"
msgstr "Multimedia-erreproduzitzaileak"

#: panel-plugin/pulseaudio-dialog.c:136 panel-plugin/pulseaudio-menu.c:271
#, c-format
msgid ""
"<big><b>Failed to execute command \"%s\".</b></big>\n"
"\n"
"%s"
msgstr "<big><b>Ezin izan da \"%s\" komandoa exekutatu.</b></big>\n\n%s"

#: panel-plugin/pulseaudio-dialog.c:139 panel-plugin/pulseaudio-menu.c:274
msgid "Error"
msgstr "Errorea"

#: panel-plugin/pulseaudio-button.c:348 panel-plugin/pulseaudio-notify.c:184
msgid "Not connected to the PulseAudio server"
msgstr "Ez dago PulseAudio zerbitzarira konektatuta"

#: panel-plugin/pulseaudio-button.c:366
#, c-format
msgid ""
"<b>Volume %d%% (muted)</b>\n"
"<small>%s</small>"
msgstr "<b>Bolumena %%%d (isilduta)</b>\n<small>%s</small>"

#: panel-plugin/pulseaudio-button.c:368
#, c-format
msgid ""
"<b>Volume %d%%</b>\n"
"<small>%s</small>"
msgstr "<b>Bolumena %%%d</b>\n<small>%s</small>"

#: panel-plugin/pulseaudio-menu.c:479
msgid "Port"
msgstr "Ataka"

#: panel-plugin/pulseaudio-menu.c:580
msgid "Output"
msgstr "Irteera"

#: panel-plugin/pulseaudio-menu.c:624
msgid "Input"
msgstr "Sarrera"

#: panel-plugin/pulseaudio-menu.c:726
msgid "Choose Playlist"
msgstr "Hautatu erreprodukzio-zerrenda"

#. Audio mixers
#: panel-plugin/pulseaudio-menu.c:761
msgid "_Audio mixer..."
msgstr "_Audio-nahasgailua..."

#: panel-plugin/pulseaudio-notify.c:186
#, c-format
msgid "Volume %d%c (muted)"
msgstr "Bolumena %d%c (isilduta)"

#: panel-plugin/pulseaudio-notify.c:188
#, c-format
msgid "Volume %d%c"
msgstr "Bolumena %d%c"

#: panel-plugin/mprismenuitem.c:378 panel-plugin/mprismenuitem.c:451
#: panel-plugin/mprismenuitem.c:806
msgid "Not currently playing"
msgstr "Ez da ezer erreproduzitzen ari"
